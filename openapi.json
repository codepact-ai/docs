    "/internal/invalidate-cache": {
      "post": {
        "operationId": "invalidateCache",
        "summary": "Invalidate Redis cache",
        "description": "Internal endpoint used by the webhook processor to invalidate frontend caches\nafter installation events (created/deleted).\n\n**Not for external use.** Requires the `x-internal-secret` header.\n\n| `type` | Effect |\n|---|---|\n| `portfolio` | Clears all `portfolio:*` keys (user installation lists) |\n| `teams` | Clears all `teams:*` keys |\n| `all` | Clears portfolio, teams, and repos caches |\n",
        "tags": [
          "Internal"
        ],
        "security": [
          {
            "InternalSecret": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "portfolio",
                      "teams",
                      "all"
                    ]
                  }
                }
              },
              "example": {
                "type": "portfolio"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cache invalidated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid cache type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing internal secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
