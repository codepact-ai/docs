    "/ai/langgraph/threads/{threadId}/runs/stream": {
      "post": {
        "operationId": "streamAIRun",
        "summary": "Stream AI agent response",
        "description": "Runs the CodePact AI agent on the given thread and streams the response using\nServer-Sent Events (SSE). Send the user's message in the request body.\n\nResponses are streamed as SSE events compatible with the `@assistant-ui/react-langgraph`\nfrontend library.\n",
        "tags": [
          "AI Chat"
        ],
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "threadId",
            "in": "path",
            "required": true,
            "description": "Thread ID from POST /ai/langgraph/threads",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array",
                    "description": "Conversation messages",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of AI agent events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
