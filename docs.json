            "group": "Installations",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "GET /installations/{id}/repositories",
              "POST /installations/{id}/sync",
              "POST /installations/{id}/sync-security",
              "POST /installations/{id}/uninstall"
            ]
          },
          {
            "group": "AI Chat",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "POST /ai/langgraph/threads",
              "POST /ai/langgraph/threads/{threadId}/runs/stream",
              "GET /ai/langgraph/threads/{threadId}/state"
            ]
          }
        ]
